{
  "repos": [
    {
      "name": "atm-harness",
      "path": "${ATM_WATCHER_AUDIT_ROOT}",
      "profile": "current-authority",
      "docs": [
        "README.md",
        "AGENTS.md",
        "CONTEXT.md",
        "docs/adr",
        "plugins/maintenance/README.md",
        "plugins/maintenance/.codex-plugin/plugin.json",
        "plugins/maintenance/.codex-plugin/skill-watcher.json",
        "plugins/maintenance/skills",
        "plugins/workflow/README.md",
        "plugins/workflow/.codex-plugin/plugin.json",
        "plugins/workflow/skills"
      ],
      "authority_paths": [
        "README.md",
        "AGENTS.md",
        "CONTEXT.md",
        "docs/adr",
        "plugins/maintenance/README.md",
        "plugins/workflow/README.md"
      ],
      "watch_terms": [],
      "link_validation": {
        "mode": "markdown-relative"
      },
      "finding_policy": "actionable",
      "check_change_alignment": true,
      "commit_threshold": 5
    }
  ]
}
