{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "atm-harness-distribution"
    },
    "algorithm": {
      "const": "sha256-atm-distribution-v1"
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Portable relative POSIX path; runtime also rejects traversal, Windows reserved names, links and reparse points."
          },
          "kind": {
            "const": "skills"
          }
        },
        "required": [
          "name",
          "path",
          "kind"
        ]
      }
    },
    "files": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Portable relative POSIX path; runtime also rejects traversal, Windows reserved names, links and reparse points."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "runtimeGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minimumPython": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 3
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "items": false
          },
          "requirementsLock": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Portable relative POSIX path; runtime also rejects traversal, Windows reserved names, links and reparse points."
              },
              {
                "type": "null"
              }
            ]
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "minimumPython",
          "imports"
        ]
      }
    },
    "runtimeBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "historicalIdentities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "directories": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "algorithm",
    "releaseVersion",
    "packages",
    "files",
    "runtimeGroups",
    "runtimeBindings",
    "historicalIdentities",
    "directories"
  ]
}
