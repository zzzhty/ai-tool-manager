{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "atm-harness-catalog"
    },
    "sourceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "plugin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "directoryName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Portable relative POSIX path; runtime also rejects traversal, Windows reserved names, links and reparse points."
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "plugin",
          "name",
          "directoryName",
          "path",
          "aliases"
        ]
      }
    },
    "attributionOverlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plugin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Portable relative POSIX path; runtime also rejects traversal, Windows reserved names, links and reparse points."
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "plugin",
          "path",
          "data"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "sourceIdentity",
    "skills",
    "attributionOverlays"
  ]
}
